# Managed for llm-code-review. Non-secret defaults.
: "${LLM_CODE_REVIEW_ROOT:=$HOME/.local/share/llm-reviewer}"
LLM_CODE_REVIEW_HOME="$LLM_CODE_REVIEW_ROOT"
LLM_CODE_REVIEW_BASE_DIR="$LLM_CODE_REVIEW_ROOT/var"
LLM_CODE_REVIEW_PROMPT="$LLM_CODE_REVIEW_ROOT/prompts/00-meta.md"
REVIEW_MODEL=gpt-5.5
REVIEW_REASONING_EFFORT=medium
REVIEW_DRY_RUN=true
POLL_INTERVAL_SECONDS=900
