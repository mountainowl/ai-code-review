#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="${LLM_CODE_REVIEW_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"
if [ "${LLM_REVIEWER_SKIP_AGENT_CONFIG_ENV:-0}" = "1" ]; then
    PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.local/bin:$PATH"
    export PATH LLM_CODE_REVIEW_ROOT="$ROOT"
    exec uv run --project "$ROOT" code-review-codex "$@"
fi
exec "$ROOT/bin/env" uv run --project "$ROOT" code-review-codex "$@"
