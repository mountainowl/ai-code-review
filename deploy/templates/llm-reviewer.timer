# systemd timer that fires the poll cycle defined in
# `llm-reviewer.service`. Copy to /etc/systemd/system/ and:
#
#   systemctl daemon-reload
#   systemctl enable --now llm-reviewer.timer
#
# Pair with `llm-reviewer-outcome-sync.timer` (separate file) for periodic
# outcome sync; or put `OnCalendar=*:17` etc. on a `Type=oneshot --sync-outcomes`
# service in a sibling unit.

[Unit]
Description=Run the LLM Reviewer poll cycle every 15 minutes
Requires=llm-reviewer.service

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
AccuracySec=30s
Unit=llm-reviewer.service
Persistent=true

[Install]
WantedBy=timers.target
